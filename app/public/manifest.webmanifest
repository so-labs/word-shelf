{
    "background_color": "#1F3A5F",
    "description": "IMEのユーザー辞書を、正本ファイル（DictionaryMaster.tsv）で管理するツールです。",
    "display": "standalone",
    "icons": [
        {
            "purpose": "any",
            "sizes": "192x192",
            "src": "icon-192.png",
            "type": "image/png"
        },
        {
            "purpose": "any",
            "sizes": "512x512",
            "src": "icon-512.png",
            "type": "image/png"
        },
        {
            "purpose": "maskable",
            "sizes": "512x512",
            "src": "icon-maskable-512.png",
            "type": "image/png"
        }
    ],
    "lang": "ja",
    "name": "Word Shelf",
    "scope": ".",
    "share_target": {
        "action": "./share-target",
        "enctype": "multipart/form-data",
        "method": "POST",
        "params": {
            "files": [
                {
                    "accept": [
                        ".tsv",
                        "text/tab-separated-values",
                        ".txt",
                        "text/plain"
                    ],
                    "name": "file"
                }
            ]
        }
    },
    "short_name": "Word Shelf",
    "start_url": ".",
    "theme_color": "#1F3A5F"
}